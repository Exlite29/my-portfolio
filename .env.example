# ---------------------------------------------------------------------------
# Contact form (/api/contact) — required in every environment that sends mail
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
# 587 = STARTTLS (default), 465 = implicit TLS. Keep them in sync with your host.
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
# From may include a display name, e.g. "Portfolio <you@example.com>"
EMAIL_FROM="Portfolio <you@example.com>"
EMAIL_TO=you@example.com

# ---------------------------------------------------------------------------
# Public (inlined into the client bundle — never put secrets here)
# ---------------------------------------------------------------------------
# Shown as a mailto link in the footer/chat when present
NEXT_PUBLIC_EMAIL=you@example.com
# Contact form endpoint; relative default posts to this app's API route
NEXT_PUBLIC_CONTACT_API=/api/contact
# Canonical production origin for metadata, sitemap.xml and robots.txt
NEXT_PUBLIC_SITE_URL=http://localhost:3000
